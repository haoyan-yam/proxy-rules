# 自动生成：改 rulesets.yaml 后运行 scripts/build.py，不要手改本文件

name: Roy 统一分流规则
desc: 与 Shadowrocket 共用同一套规则源 · github.com/haoyan-yam/proxy-rules
# 规则顺序：局域网 → 个人直连 → 个人代理 → OpenAI → Claude → Gemini → Apple News → Apple → 海外常用 → 国内 → GEOIP CN 直连 → 其余走代理

proxy-groups: #!append
  - name: 🍎 苹果服务
    type: select
    proxies:
      - 🎯 全球直连
      - 🚀 节点选择

rule-providers:
  lan:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Lan/Lan_No_Resolve.yaml
    interval: 86400
  personal_direct:
    behavior: classical
    format: text
    url: https://cdn.jsdelivr.net/gh/haoyan-yam/proxy-rules@main/rules/personal_direct.list
    interval: 86400
  personal_proxy:
    behavior: classical
    format: text
    url: https://cdn.jsdelivr.net/gh/haoyan-yam/proxy-rules@main/rules/personal_proxy.list
    interval: 86400
  openai:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/OpenAI/OpenAI_No_Resolve.yaml
    interval: 86400
  claude:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Claude/Claude_No_Resolve.yaml
    interval: 86400
  gemini:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Gemini/Gemini_No_Resolve.yaml
    interval: 86400
  applenews:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppleNews/AppleNews_No_Resolve.yaml
    interval: 86400
  apple_domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Apple/Apple_Domain.yaml
    interval: 86400
  apple:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Apple/Apple_No_Resolve.yaml
    interval: 86400
  global_domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Global/Global_Domain.yaml
    interval: 86400
  global:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Global/Global_No_Resolve.yaml
    interval: 86400
  china_domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/China/China_Domain.yaml
    interval: 86400
  china:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/China/China_No_Resolve.yaml
    interval: 86400

# 默认插到本地基础配置的规则之前；基础配置里只有 MATCH,🐟 漏网之鱼
rules:
  # 局域网
  - RULE-SET,lan,🎯 全球直连
  # 个人直连
  - RULE-SET,personal_direct,🎯 全球直连
  # 个人代理
  - RULE-SET,personal_proxy,🚀 节点选择
  # OpenAI
  - RULE-SET,openai,🚀 节点选择
  # Claude
  - RULE-SET,claude,🚀 节点选择
  # Gemini
  - RULE-SET,gemini,🚀 节点选择
  # Apple News
  - RULE-SET,applenews,🚀 节点选择
  # Apple
  - RULE-SET,apple_domain,🍎 苹果服务
  - RULE-SET,apple,🍎 苹果服务
  # 海外常用
  - RULE-SET,global_domain,🚀 节点选择
  - RULE-SET,global,🚀 节点选择
  # 国内
  - RULE-SET,china_domain,🎯 全球直连
  - RULE-SET,china,🎯 全球直连
  # 兜底（MATCH 在本地基础配置里）
  - GEOIP,CN,🎯 全球直连
