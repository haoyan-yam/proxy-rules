# 自动生成：改 rulesets.yaml 后运行 scripts/build.py，不要手改本文件

name: Roy 统一分流规则
desc: 统一分流 + 直连域名国内 DoH / 默认 Cloudflare 经代理；升级与策略组切换限制见 README
# 此文件仅供 Stash；Shadowrocket 的 DNS 在 shadowrocket.conf 中单独生成。
# 合并版启用后关闭旧的「Roy DNS 经代理」本地覆写，避免重复。
# DNS policy 按域名规则顺序匹配；Apple 按默认直连处理，不跟随策略组手动切换。
dns:
  follow-rule: true
  skip-cert-verify: false
  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://1.0.0.1/dns-query
  # 清除基础配置的并发 fallback，避免旁路查询。
  fallback: #!replace
    []
  # 完全替换旧 policy，防止继承的精确域名策略优先于本仓库集合。
  nameserver-policy: #!replace
    'rule-set:lan':
      - https://223.5.5.5/dns-query
      - https://223.6.6.6/dns-query
    'rule-set:personal_direct':
      - https://223.5.5.5/dns-query
      - https://223.6.6.6/dns-query
    'rule-set:personal_proxy':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:openai':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:claude':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:gemini':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:applenews':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:apple_domain':
      - https://223.5.5.5/dns-query
      - https://223.6.6.6/dns-query
    'rule-set:apple':
      - https://223.5.5.5/dns-query
      - https://223.6.6.6/dns-query
    'rule-set:global_domain':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:global':
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
    'rule-set:china_domain':
      - https://223.5.5.5/dns-query
      - https://223.6.6.6/dns-query
    'rule-set:china':
      - https://223.5.5.5/dns-query
      - https://223.6.6.6/dns-query

# 规则顺序：DNS 服务器 IP 指定出口 → Stash 专用直连 → 局域网 → 个人直连 → 个人代理 → OpenAI → Claude → Gemini → Apple News → Apple → 海外常用 → 国内 → GEOIP CN 直连 → 其余走代理

# 注意：覆写不定义策略组。基础配置（VIRCS 自建 / WgetCloud 等机场订阅）里已有同名组，重复定义会报 duplicate proxy name
rule-providers:
  lan:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Lan/Lan_No_Resolve.yaml
    interval: 86400
  personal_direct:
    behavior: classical
    format: text
    url: https://cdn.jsdelivr.net/gh/haoyan-yam/proxy-rules@main/rules/personal_direct.list
    interval: 86400
  personal_proxy:
    behavior: classical
    format: text
    url: https://cdn.jsdelivr.net/gh/haoyan-yam/proxy-rules@main/rules/personal_proxy.list
    interval: 86400
  openai:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/OpenAI/OpenAI_No_Resolve.yaml
    interval: 86400
  claude:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Claude/Claude_No_Resolve.yaml
    interval: 86400
  gemini:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Gemini/Gemini_No_Resolve.yaml
    interval: 86400
  applenews:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AppleNews/AppleNews_No_Resolve.yaml
    interval: 86400
  apple_domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Apple/Apple_Domain.yaml
    interval: 86400
  apple:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Apple/Apple_No_Resolve.yaml
    interval: 86400
  global_domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Global/Global_Domain.yaml
    interval: 86400
  global:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Global/Global_No_Resolve.yaml
    interval: 86400
  china_domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/China/China_Domain.yaml
    interval: 86400
  china:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/China/China_No_Resolve.yaml
    interval: 86400

# 覆写的规则会插到基础配置的规则之前，并以 MATCH 结尾：基础配置自带的规则（比如机场订阅里的上万条）不会再生效
# 基础配置必须定义这 4 个策略组：🚀 节点选择 / 🎯 全球直连 / 🍎 苹果服务 / 🐟 漏网之鱼
rules:
  # 必须先于所有业务规则和 MATCH，确保 DNS 不依赖兜底组选择
  - IP-CIDR,1.1.1.1/32,🚀 节点选择,no-resolve
  - IP-CIDR,1.0.0.1/32,🚀 节点选择,no-resolve
  - IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
  - IP-CIDR,223.6.6.6/32,DIRECT,no-resolve
  # Tailscale 控制连接、STUN 与常用直连端口；不改变 DNS policy 或系统路由
  - DOMAIN-SUFFIX,tailscale.com,DIRECT
  - DST-PORT,3478,DIRECT
  - DST-PORT,41641,DIRECT
  # 局域网
  - RULE-SET,lan,🎯 全球直连
  # 个人直连
  - RULE-SET,personal_direct,🎯 全球直连
  # 个人代理
  - RULE-SET,personal_proxy,🚀 节点选择
  # OpenAI
  - RULE-SET,openai,🚀 节点选择
  # Claude
  - RULE-SET,claude,🚀 节点选择
  # Gemini
  - RULE-SET,gemini,🚀 节点选择
  # Apple News
  - RULE-SET,applenews,🚀 节点选择
  # Apple
  - RULE-SET,apple_domain,🍎 苹果服务
  - RULE-SET,apple,🍎 苹果服务
  # 海外常用
  - RULE-SET,global_domain,🚀 节点选择
  - RULE-SET,global,🚀 节点选择
  # 国内
  - RULE-SET,china_domain,🎯 全球直连
  - RULE-SET,china,🎯 全球直连
  # 兜底
  - GEOIP,CN,🎯 全球直连
  - MATCH,🐟 漏网之鱼
